# Copy to .env and fill in. (.env is gitignored; it's loaded by both Prisma CLI and Next.js.)

# --- Supabase Postgres ---
# Runtime: Supavisor transaction pooler (port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations: Supavisor session pooler (port 5432 on the pooler host — IPv4-friendly,
# unlike the IPv6-only db.<ref>.supabase.co direct host).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Storage / client ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."          # server only
SUPABASE_STORAGE_BUCKET="campaign-covers"
# Optional: dedicated bucket for creator-uploaded submission screenshots.
# Falls back to SUPABASE_STORAGE_BUCKET when unset.
SUBMISSION_SCREENSHOTS_BUCKET="submission-screenshots"

# --- Platform metrics APIs ---
# YouTube Data API v3 key (Google Cloud Console → Credentials). Optional —
# without it, YouTube auto-verification stays null and reviewers fill manually.
YOUTUBE_API_KEY=""

# --- Site / OAuth ---
# Used to build the Google OAuth redirectTo URL. In production this MUST be
# your real domain; in development "http://localhost:3000" is fine.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Invoice issuer (KlippUp platform main subject) ---
# Used on every PDF factura the platform emits to brands. Production MUST set
# these to your real Spanish company details — dev falls back to placeholders
# so PDFs still render, but those invoices are not legally valid.
PLATFORM_LEGAL_NAME="KlippUp S.L."
PLATFORM_TAX_ID="B00000000"
PLATFORM_TAX_ID_TYPE="CIF"
PLATFORM_ADDRESS_STREET="Calle Ejemplo 1, 1º A"
PLATFORM_ADDRESS_CITY="Madrid"
PLATFORM_ADDRESS_POSTAL_CODE="28001"
PLATFORM_ADDRESS_REGION="Madrid"
PLATFORM_ADDRESS_COUNTRY="ES"
PLATFORM_IBAN="ES00 0000 0000 0000 0000 0000"
PLATFORM_EMAIL="facturacion@klippup.com"
