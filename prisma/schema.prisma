// KlippUp — data model. See docs/admin-plan.md for the rationale.
// Prisma 7: connection URLs live in prisma.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- accounts ----------
//
// Auth lives in Supabase's `auth.users` table — we don't replicate it here.
// `Profile.id` is the same UUID Supabase issues, written by an auth.signUp
// callback (or first OAuth login). `role` decides which sub-profile exists.

enum UserRole {
  CREATOR
  BRAND
  ADMIN
}

model Profile {
  id          String   @id // = auth.users.id (UUID)
  role        UserRole
  email       String   @unique
  displayName String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator       CreatorProfile?
  brand         BrandProfile?
  // back-relation to campaigns owned by a brand user (one-to-many)
  campaigns     Campaign[]      @relation("CampaignBrandOwner")
  submissions   Submission[]    @relation("CreatorSubmissions")
  reviewed      Submission[]    @relation("ReviewedSubmissions")
  payouts       Payout[]
  notifications Notification[]
  invoices      Invoice[]
}

model CreatorProfile {
  userId      String   @id
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  // socials = { tiktok?: string; youtube?: string; instagram?: string; ... }
  socials     Json?
  // LEGACY (pre-Phase F): { method, details }. Replaced by iban + payoutMethod;
  // kept until the back-fill is done so old reads don't break.
  payoutInfo  Json?
  // Stored in cents; updated by the manual settlement flow.
  totalEarned Int      @default(0)
  status      String   @default("ACTIVE") // ACTIVE | SUSPENDED

  // Fiscal / KYC — Spain-only v1, but `country` keeps the door open.
  // All optional at signup; required before first submission (see lib/tax.ts).
  legalName     String?
  taxIdType     TaxIdType?
  taxId         String?
  country       String?    @default("ES") // ISO-2
  birthDate     DateTime?
  // address = { street, city, postalCode, region }
  address       Json?
  isAutonomo    Boolean    @default(false)
  // First day of `actividad económica` — used to compute the 7%→15% IRPF step.
  autonomoSince DateTime?
  iban          String?
  // Optional DNI/NIE scan; required once cumulative PAID ≥ €1000.
  idDocumentUrl String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BrandProfile {
  userId      String   @id
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandName   String
  verified    Boolean  @default(false) // official-brand badge (admin-set)
  website     String?
  description String?
  status      String   @default("ACTIVE") // ACTIVE | SUSPENDED

  // Billing — required before publishing a campaign (see lib/tax.ts).
  // `country + taxIdType` decide IVA: ES = 21%, EU+VAT = reverse charge 0%,
  // non-EU = export of services 0%.
  legalName     String?
  taxIdType     TaxIdType?
  taxId         String?
  country       String?    @default("ES") // ISO-2
  // address = { street, city, postalCode, region }
  address       Json?
  billingEmail  String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Shared across creators (DNI/NIE) and brands (NIF/CIF/VAT). OTHER is for
// non-Spain fallbacks we don't ship as separate flows yet.
enum TaxIdType {
  DNI
  NIE
  NIF
  CIF
  VAT
  OTHER
}

// ---------- taxonomy ----------

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  label     String // default badge text shown on cards ("UGC", "Music", ...)
  sortOrder Int        @default(0)
  campaigns Campaign[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Platform {
  id          String             @id @default(cuid())
  slug        String             @unique // tiktok / youtube / instagram / x / twitch
  label       String // "TikTok" ...
  glyph       String // short mark used on cards ("TT", "YT", ...)
  sortOrder   Int                @default(0)
  campaigns   CampaignPlatform[]
  submissions Submission[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

// ---------- campaigns ----------

model Campaign {
  id String @id @default(cuid())

  // brand — display name kept inline; brandUserId points at the Profile that
  // owns the campaign (null for platform-seeded campaigns).
  brand         String
  brandVerified Boolean  @default(true)
  brandUser     Profile? @relation("CampaignBrandOwner", fields: [brandUserId], references: [id])
  brandUserId   String?

  // copy
  title       String
  artTitle    String? // stylized art lettering on the cover / hero (may contain \n)
  description String

  // media
  coverUrl String // Supabase Storage public URL

  // category
  category      Category @relation(fields: [categoryId], references: [id])
  categoryId    String
  categoryLabel String? // per-campaign badge override; falls back to category.label

  // platforms
  platforms CampaignPlatform[]

  // numbers
  raised       Int
  budget       Int
  participants Int
  rate         String // display text, e.g. "$1/1K"

  launchedAt DateTime @default(now()) // replaces the old hardcoded ageDays

  // placement — a campaign may appear in several slots at once
  placements CampaignPlacement[]
  hot        Boolean             @default(false)
  status     CampaignStatus      @default(PUBLISHED)

  // detail panel (the modal) — was hardcoded, now editable
  poweredBy         String?
  requirementsSteps Int?
  requirements      String[] @default([]) // bullet list of content requirements
  earnings          Json? // { tiktok?: {rate,min,max}, youtube?: {...}, instagram?: {...}, x?: {...} }
  topEarners        Json? // [{ name, views }]
  resources         Json? // [{ name, subtitle, kind: "drive" | "link", url }]
  totalViews        String? // "3.8M" / "63.6万"
  viewsSeries       Int[]    @default([]) // points for the small views chart

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  submissions Submission[]
  invoices    Invoice[]

  @@index([status])
}

model CampaignPlacement {
  id         String        @id @default(cuid())
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  slot       PlacementSlot
  sortOrder  Int           @default(0) // ordering within a slot

  @@unique([campaignId, slot])
  @@index([slot, sortOrder])
}

model CampaignPlatform {
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String
  platform   Platform @relation(fields: [platformId], references: [id])
  platformId String
  order      Int      @default(0)

  @@id([campaignId, platformId])
}

enum PlacementSlot {
  HERO
  FEATURED
  GRID
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---------- submissions ----------

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Submission {
  id String @id @default(cuid())

  // who & what
  creator    Profile  @relation("CreatorSubmissions", fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId  String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignId String

  // platform of the submitted clip; FK so we can show its label/glyph.
  platform   Platform @relation(fields: [platformId], references: [id])
  platformId String

  // submission payload — `videoId` is parsed from the URL, `apiData` is the
  // platform-API snapshot (YT statistics / TikTok oEmbed) taken at create time.
  // `screenshotUrl` is an optional creator-uploaded proof image with timestamp —
  // a faster signal for the reviewer than recomputing metrics.
  videoUrl      String
  videoId       String?
  viewsClaimed  Int? // creator-declared
  screenshotUrl String?
  apiData       Json?

  // review
  status        SubmissionStatus @default(PENDING)
  viewsVerified Int? // filled by reviewer
  earningsCents Int              @default(0) // computed once approved
  rejectReason  String?
  reviewedBy    Profile?         @relation("ReviewedSubmissions", fields: [reviewedById], references: [id])
  reviewedById  String?
  reviewedAt    DateTime?

  notes String? // free-form notes from reviewer

  // settlement (Phase D)
  payout   Payout? @relation(fields: [payoutId], references: [id])
  payoutId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
  @@index([campaignId])
  @@index([status])
  @@index([payoutId])
}

// ---------- payouts ----------

model Payout {
  id          String   @id @default(cuid())
  creator     Profile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId   String
  amountCents Int // = sum of attached submission earnings at time of payout
  method      String // "paypal" | "bank" | "other" — snapshotted from CreatorProfile at payout time
  details     String? // free-text destination (PayPal email / bank / etc.)
  txnRef      String? // confirmation / transaction reference
  notes       String?
  status      String   @default("PAID") // PAID — keeping room for PENDING/FAILED
  paidAt      DateTime @default(now())

  submissions Submission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorId])
}

// ---------- invoices ----------
//
// Spain factura (Phase F.2). Each invoice freezes a snapshot of both the
// issuer (KlippUp platform main subject, from env) and the recipient (brand)
// at issue time — historical invoices must NEVER change when someone edits
// their profile. Serial numbers are atomic per year via InvoiceCounter.

enum InvoiceStatus {
  PROFORMA
  ISSUED
  PAID
  CANCELLED
}

model Invoice {
  id String @id @default(cuid())

  // F-YYYY-NNNN — globally unique, resets per year via InvoiceCounter.
  serialNumber String @unique
  year         Int

  brandUser   Profile @relation(fields: [brandUserId], references: [id])
  brandUserId String

  // Nullable: future ad-hoc / monthly aggregate invoices won't tie to one campaign.
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  campaignId String?

  issueDate   DateTime @default(now())
  description String

  // Money is in cents; IVA stored as integer percent (21 = 21%, 0 = reverse charge / export).
  baseCents      Int
  ivaRatePercent Int
  ivaCents       Int
  totalCents     Int
  // "ES" | "REVERSE_CHARGE" | "EXPORT" — matches lib/tax.ts IvaNote.
  ivaNote        String

  // Issuer + recipient snapshots, captured at create time.
  snapshotPlatform Json
  snapshotBrand    Json

  status InvoiceStatus @default(PROFORMA)
  paidAt DateTime?
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandUserId])
  @@index([campaignId])
  @@index([status])
  @@index([year])
}

// Atomic per-year serial counter. Increment inside a transaction with an
// upsert + update returning so two parallel issuances never collide.
model InvoiceCounter {
  year       Int      @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}

// ---------- notifications ----------
//
// Type + payload (not pre-rendered text) so we can re-localize on read. The
// query layer pulls translations from next-intl using the request's locale.

enum NotificationType {
  SUBMISSION_APPROVED
  SUBMISSION_REJECTED
  PAYOUT_SENT
  CAMPAIGN_PUBLISHED
}

model Notification {
  id        String           @id @default(cuid())
  user      Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      NotificationType
  // Free-form context used by the renderer (campaignTitle / submissionId /
  // amountCents / rejectReason). Keep keys small — they're read on every list.
  payload   Json
  link      String? // optional click-through (e.g. /creator/submissions)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}
